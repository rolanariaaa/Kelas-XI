<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💳 Isi Saldo Dompet"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00897B"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Saldo Saat Ini -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E0F7FA"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo Saat Ini"
            android:textSize="12sp"
            android:textColor="#00695C" />

        <TextView
            android:id="@+id/tvCurrentSaldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#00897B"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Pilihan Nominal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Nominal:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:layout_marginBottom="12dp" />

    <!-- Nominal 50K -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn50k"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Rp 50.000"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#00897B"
        android:layout_marginBottom="8dp" />

    <!-- Nominal 100K -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn100k"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Rp 100.000"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#00897B"
        android:layout_marginBottom="8dp" />

    <!-- Nominal 250K -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn250k"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Rp 250.000"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#00897B"
        android:layout_marginBottom="8dp" />

    <!-- Nominal 500K -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn500k"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Rp 500.000"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#00897B"
        android:layout_marginBottom="8dp" />

    <!-- Nominal 1JT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn1jt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Rp 1.000.000"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#00897B"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Batal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Batal"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#BDBDBD"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
