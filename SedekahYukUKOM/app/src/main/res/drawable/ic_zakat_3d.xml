<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4CAF50"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#81C784"/>
        </shape>
    </item>
    
    <!-- Document base -->
    <item
        android:left="18dp"
        android:top="14dp"
        android:right="18dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    
    <!-- Checkmark circle -->
    <item
        android:left="32dp"
        android:top="14dp"
        android:right="16dp"
        android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#FF6D00"/>
        </shape>
    </item>
    
    <!-- Crescent shape -->
    <item
        android:left="22dp"
        android:top="28dp"
        android:right="30dp"
        android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#2E7D32"/>
        </shape>
    </item>
</layer-list>
