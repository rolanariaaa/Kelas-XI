<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle blue -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2196F3"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light blue overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#64B5F6"/>
        </shape>
    </item>
    
    <!-- Calendar shape -->
    <item
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Calendar header -->
    <item
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#1976D2"/>
            <corners
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp"/>
        </shape>
    </item>
    
    <!-- Refresh circle -->
    <item
        android:left="36dp"
        android:top="32dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#FF6D00"/>
            <size android:width="16dp" android:height="16dp"/>
        </shape>
    </item>
</layer-list>
