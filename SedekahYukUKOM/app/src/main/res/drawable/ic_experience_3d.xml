<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00BCD4"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#4DD0E1"/>
        </shape>
    </item>
    
    <!-- Box shape -->
    <item
        android:left="16dp"
        android:top="20dp"
        android:right="16dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#0097A7"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Box top -->
    <item
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#00ACC1"/>
            <corners
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp"/>
        </shape>
    </item>
    
    <!-- Star icon -->
    <item
        android:left="26dp"
        android:top="26dp"
        android:right="26dp"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="#FFC107"/>
        </shape>
    </item>
</layer-list>
