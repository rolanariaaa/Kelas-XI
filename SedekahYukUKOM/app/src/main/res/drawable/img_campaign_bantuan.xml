<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left side - flood photo area -->
    <item android:right="200dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#90A4AE"
                android:centerColor="#78909C"
                android:endColor="#546E7A"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Right side - brown/gold banner -->
    <item android:left="200dp">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#8D6E63"
                android:centerColor="#A1887F"
                android:endColor="#BCAAA4"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Bottom brown section for bank info -->
    <item android:top="140dp">
        <shape>
            <solid android:color="#6D4C41" />
        </shape>
    </item>
</layer-list>
