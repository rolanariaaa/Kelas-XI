<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF4081"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#FF80AB"/>
        </shape>
    </item>
    
    <!-- Grid 1 -->
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="34dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Grid 2 -->
    <item
        android:left="32dp"
        android:top="18dp"
        android:right="20dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Grid 3 -->
    <item
        android:left="18dp"
        android:top="32dp"
        android:right="34dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    
    <!-- Grid 4 -->
    <item
        android:left="32dp"
        android:top="32dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>
