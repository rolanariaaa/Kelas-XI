<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00BCD4"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#4DD0E1"/>
        </shape>
    </item>
    
    <!-- Shield shape -->
    <item
        android:left="18dp"
        android:top="14dp"
        android:right="18dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#0097A7"/>
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp"/>
        </shape>
    </item>
    
    <!-- People icon (left) -->
    <item
        android:left="20dp"
        android:top="22dp"
        android:right="34dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    
    <!-- People icon (center) -->
    <item
        android:left="26dp"
        android:top="22dp"
        android:right="26dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    
    <!-- People icon (right) -->
    <item
        android:left="34dp"
        android:top="22dp"
        android:right="20dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>
