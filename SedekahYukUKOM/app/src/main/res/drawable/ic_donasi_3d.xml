<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00BCD4"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#4DD0E1"/>
        </shape>
    </item>
    
    <!-- Hand shape -->
    <item
        android:left="18dp"
        android:top="22dp"
        android:right="18dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    
    <!-- Coin 1 -->
    <item
        android:left="24dp"
        android:top="14dp"
        android:right="32dp"
        android:bottom="36dp">
        <shape android:shape="oval">
            <solid android:color="#FFC107"/>
            <stroke android:width="1dp" android:color="#FF8F00"/>
        </shape>
    </item>
    
    <!-- Coin 2 -->
    <item
        android:left="32dp"
        android:top="10dp"
        android:right="24dp"
        android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="#FFCA28"/>
            <stroke android:width="1dp" android:color="#FF8F00"/>
        </shape>
    </item>
</layer-list>
