<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#20000000"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF9800"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    
    <!-- Light overlay -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFB74D"/>
        </shape>
    </item>
    
    <!-- Infinity base -->
    <item
        android:left="14dp"
        android:top="24dp"
        android:right="14dp"
        android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    
    <!-- Left circle -->
    <item
        android:left="18dp"
        android:top="20dp"
        android:right="34dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="3dp" android:color="#F57C00"/>
        </shape>
    </item>
    
    <!-- Right circle -->
    <item
        android:left="34dp"
        android:top="20dp"
        android:right="18dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="3dp" android:color="#F57C00"/>
        </shape>
    </item>
</layer-list>
