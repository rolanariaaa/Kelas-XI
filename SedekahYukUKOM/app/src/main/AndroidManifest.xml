<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SedekahYuk">
        
        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Authentication -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Main -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        
        <!-- Features -->
        <activity
            android:name=".ui.sedekah.SedekahActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".ui.kampanye.KampanyeActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.kampanye.DetailKampanyeActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.riwayat.RiwayatActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.artikel.ArtikelActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.artikel.DetailArtikelActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.profil.ProfilActivity"
            android:exported="false" />
        
        <!-- New Features - Modern UI -->
        <activity
            android:name=".ui.statistik.StatistikActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.notifikasi.NotifikasiActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.salingjaga.SalingJagaActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.dampak.DampakActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.zakat.ZakatActivity"
            android:exported="false" />
            
    </application>

</manifest>
